    {
      "id": "def:rand-protocol-complex",
      "kind": "definition",
      "position": 26,
      "chapter": "4-randomised-eval",
      "source": "chapter/4-randomised-eval.tex",
      "line": 3,
      "title": "Randomised complexity of a protocol",
      "labels": [
