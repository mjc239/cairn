      "kind": "lemma",
      "position": 18,
      "chapter": "2-lower-bound-eval",
      "source": "chapter/2-lower-bound-eval.tex",
      "line": 18,
      "title": "Forbidden patterns project to multidimensional corners",
      "labels": [
        "lem:forbidden-pattern-project-multicorner"
      ],
      "lean_decls": [
        "NOF.isMultidimCorner_forget_of_isForbiddenPattern"
      ],
      "leanok": true,
      "mathlibok": false,
      "statement_uses": [
        "def:forbidden-pattern",
