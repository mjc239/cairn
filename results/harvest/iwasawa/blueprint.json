      "has_proof": true,
      "statement_event": 47,
      "proof_event": 48,
      "proof_chapter": "arithmetic-of-p-extensions",
      "proof_leanok": false,
      "text": "$X$ has a natural, well-defined $\\Gamma$-action, given by $\\sigma\\bullet x =\\widetilde\\sigma x\\widetilde\\sigma^{-1}$ where $\\widetilde\\sigma\\in G$ is any lifting of $\\sigma\\in\\Gamma$."
    },
    {
      "id": "p-primary-part",
      "kind": "definition",
      "position": 10,
      "chapter": "arithmetic-of-p-extensions",
      "source": "content.tex",
      "line": 1454,
