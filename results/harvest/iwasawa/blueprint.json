      ],
      "proof_uses": [],
      "has_proof": false,
      "statement_event": 51,
      "proof_event": null,
      "proof_chapter": null,
      "proof_leanok": false,
      "text": "For each $n\\geq 0$ let $L_n$ be the maximal unramified abelian extension of $K_n$ of exponent $p$. Let $X_n:=\\Gal(L_n/K_n)$."
    },
    {
      "id": "Zp-ext-An",
      "kind": "definition",
      "position": 12,
      "chapter": "arithmetic-of-p-extensions",
      "source": "content.tex",
      "line": 1475,
      "title": null,
      "labels": [
        "Zp-ext-An"
      ],
      "lean_decls": [],
      "leanok": false,
      "mathlibok": false,
      "statement_uses": [
