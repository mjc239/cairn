      ],
      "proof_uses": [],
      "has_proof": true,
      "statement_event": 9,
      "proof_event": 10,
      "proof_chapter": "discriminants-of-number-fields",
      "proof_leanok": true,
      "text": "Let $K$ be a number field with basis $B=\\{b_1,\\dots,b_n\\}$ and let $\\sigma_1,\\dots,\\sigma_n$ be the embeddings of $K$ into $\\CC$. Now let $M$ be the matrix \\[\\left (\\begin{matrix} \\sigma_1(b_1) &\\cdots& \\sigma_1(b_n)\\\\ \\vdots & & \\vdots \\\\ \\sigma_n(b_1) &\\cdots& \\sigma_n(b_n) \\end{matrix} \\right ).\\] Then \\[\\Delta(B)=\\det(M)^2.\\]"
    },
    {
      "id": "lemma:disc_of_prim_elt_basis",
      "kind": "lemma",
      "position": 6,
      "chapter": "discriminants-of-number-fields",
      "source": "demo.tex",
      "line": 70,
