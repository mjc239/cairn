      ],
      "proof_uses": [],
      "has_proof": true,
      "statement_event": 11,
      "proof_event": 12,
      "proof_chapter": "discriminants-of-number-fields",
      "proof_leanok": true,
      "text": "Let $K$ be a number field and $B=\\{1,\\a,\\a^2,\\dots,\\a^{n-1}\\}$ for some $\\a \\in K$. Then \\[\\Delta(B)=\\prod_{i < j} (\\sigma_i(\\a)-\\sigma_j(\\a))^2\\] where $\\sigma_i$ are the embeddings of $K $ into $\\CC$. Here $\\Delta(B)$ denotes the discriminant."
    },
    {
      "id": "lemma:diff_of_irr_pol",
      "kind": "lemma",
      "position": 7,
